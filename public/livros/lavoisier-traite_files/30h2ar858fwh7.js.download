lout | Accordion | Callout | Carousel | ImageGallery | SectionBlock | Table | Tabs | Card)[], variant?: \\"card\\" | \\"clear\\" | \\"sunk\\", direction?: \\"row\\" | \\"column\\", gap?: \\"xs\\" | \\"s\\" | \\"m\\" | \\"l\\", align?: \\"start\\" | \\"center\\" | \\"end\\" | \\"stretch\\", justify?: \\"start\\" | \\"center\\" | \\"end\\" | \\"space-between\\")","description":"Groups related content and nested Cards into responsive visual compositions. Omitted layout props preserve existing cards; use clear explicitly for transparent groups."},"BarChart":{"signature":"BarChart(title: string, labels: string[], series: Series[], variant?: \\"grouped\\" | \\"stacked\\", xLabel?: string, yLabel?: string)","description":"Compares one or more series across categories with bars."},"LineChart":{"signature":"LineChart(title: string, labels: string[], series: Series[], curve?: \\"linear\\" | \\"monotone\\" | \\"step\\", xLabel?: string, yLabel?: string)","description":"Shows changes or trends across ordered categories."},"AreaChart":{"signature":"AreaChart(title: string, labels: string[], series: Series[], curve?: \\"linear\\" | \\"monotone\\" | \\"step\\", xLabel?: string, yLabel?: string)","description":"Shows trends with filled areas emphasizing magnitude."},"RadarChart":{"signature":"RadarChart(title: string, labels: string[], series: Series[], xLabel?: string, yLabel?: string)","description":"Compares multivariate profiles around a radial axis."},"HorizontalBarChart":{"signature":"HorizontalBarChart(title: string, labels: string[], series: Series[], xLabel?: string, yLabel?: string)","description":"Ranks categorical values with horizontal bars."},"SingleStackedBarChart":{"signature":"SingleStackedBarChart(title: string, labels: string[], values: number[])","description":"Shows how labeled values contribute to one whole."},"PieChart":{"signature":"PieChart(title: string, labels: string[], values: number[], variant?: \\"pie\\" | \\"donut\\")","description":"Shows proportional parts of a whole as a pie or donut."},"RadialChart":{"signature":"RadialChart(title: string, labels: string[], values: number[])","description":"Shows percentage values as radial progress bars."},"ScatterChart":{"signature":"ScatterChart(title: string, datasets: ScatterSeries[], xLabel?: string, yLabel?: string)","description":"Shows relationships between two numeric variables."},"Separator":{"signature":"Separator()","description":"Separates adjacent Card content with a horizontal rule."},"StepsItem":{"signature":"StepsItem(number: number, title: string, description: string, trailNextStep?: boolean)","description":"Displays one numbered step with a title, description, and an optional trail to the next step."},"Steps":{"signature":"Steps(children: StepsItem[])","description":"Groups an ordered sequence of numbered instructions into one visual surface."},"Tag":{"signature":"Tag(text: string, size?: \\"sm\\" | \\"md\\" | \\"lg\\", variant?: \\"neutral\\" | \\"info\\" | \\"success\\" | \\"warning\\" | \\"danger\\")","description":"Highlights a short status, category, or label with a semantic appearance."},"TagBlock":{"signature":"TagBlock(children: Tag[])","description":"Groups related tags in a responsive, wrapping collection."},"TextContent":{"signature":"TextContent(text: string, size?: \\"small\\" | \\"default\\" | \\"large\\" | \\"small-heavy\\" | \\"large-heavy\\")","description":"Displays a semantic block of text with optional Markdown formatting and a visual size."},"TextCallout":{"signature":"TextCallout(title?: string, description?: string, variant?: \\"neutral\\" | \\"info\\" | \\"success\\" | \\"warning\\" | \\"danger\\")","description":"Displays a short semantic notice with an optional title and description."},"Callout":{"signature":"Callout(title: string, description: string, variant?: \\"info\\" | \\"success\\" | \\"warning\\" | \\"error\\" | \\"neutral\\")","description":"Displays a titled semantic message with supporting descriptive text."},"Button":{"signature":"Button(label: string, value: string, humanFriendlyMessage: string, hierarchy?: \\"primary\\" | \\"secondary\\" | \\"tertiary\\", type?: \\"normal\\" | \\"destructive\\", size?: 24 | 28 | 32 | 36)","description":"Triggers a safe, structured conversation action from a labeled button."},"Buttons":{"signature":"Buttons(buttons: Button[], direction?: \\"row\\" | \\"column\\")","description":"Groups one to six conversation actions in a responsive row or column."},"Image":{"signature":"Image(alt: string, src?: string)","description":"Displays an accessible image from an optional trusted source URL."},"ImageBlock":{"signature":"ImageBlock(image: Image, heading: string, description: string)","description":"Displays an accessible image with a concise heading and supporting description."},"ImageGallery":{"signature":"ImageGallery(children: ImageBlock[])","description":"Displays one to twelve related image blocks in a responsive gallery."},"ListBlock":{"signature":"ListBlock(children: ListItem[])","description":"Groups related list items in one compact, scannable surface."},"ListItem":{"signature":"ListItem(title: string, subtitle?: string)","description":"Displays one concise list point with a required title and optional supporting subtitle."},"CardHeader":{"signature":"CardHeader(title?: string, subtitle?: string)","description":"Introduces Card content with an optional title, optional supporting subtitle, or both."},"Carousel":{"signature":"Carousel(children: (Catalog | Dashboard | Form | Link | BarChart | LineChart | AreaChart | RadarChart | HorizontalBarChart | SingleStackedBarChart | PieChart | RadialChart | ScatterChart | Button | Buttons | CardHeader | Image | ImageBlock | ListBlock | ListItem | Separator | Steps | StepsItem | Tag | TagBlock | TextContent | TextCallout | CardHeader)[][], variant?: \\"card\\" | \\"sunk\\")","description":"Presents one to twelve slides of composed OpenUI content with accessible manual navigation."},"Tabs":{"signature":"Tabs(children: TabItem[])","description":"Organizes related content into an accessible, single-selected tab set."},"SectionBlock":{"signature":"SectionBlock(children: SectionItem[])","description":"Groups related titled sections with supporting descriptions in one static surface."},"Accordion":{"signature":"Accordion(children: AccordionItem[])","description":"Groups related questions and answers in a single-open disclosure surface."},"Table":{"signature":"Table(columns: Col[])","description":"Displays one to twelve labeled Col references as a static row-oriented data table."},"Series":{"signature":"Series(name: string, values: number[])","description":"A named numeric series used by cartesian and radar charts."},"ScatterSeries":{"signature":"ScatterSeries(name: string, points: Point[])","description":"A named collection of points used by a scatter chart."},"Point":{"signature":"Point(x: number, y: number)","description":"One numeric x/y point used by a scatter series."},"TabItem":{"signature":"TabItem(value: string, trigger: string, content: (Catalog | Dashboard | Form | Link | BarChart | LineChart | AreaChart | RadarChart | HorizontalBarChart | SingleStackedBarChart | PieChart | RadialChart | ScatterChart | Button | Buttons | CardHeader | Image | ImageBlock | ListBlock | ListItem | Separator | Steps | StepsItem | Tag | TagBlock | TextContent | TextCallout | Accordion | Callout | Carousel | ImageGallery | SectionBlock | Table | Tabs | Card)[])","description":"Defines one labeled tab and the content shown when its value is selected."},"SectionItem":{"signature":"SectionItem(title: string, description: string)","description":"Defines one static titled section with supporting descriptive text for composition inside SectionBlock."},"AccordionItem":{"signature":"AccordionItem(value: string, title: string, description: string)","description":"Defines one expandable accordion item with a stable value, title, and textual description."},"Col":{"signature":"Col(label: string, data: (string | number)[], type?: \\"string\\" | \\"number\\")","description":"Defines one labeled column of static string or finite numeric values for composition inside Table."},"Slice":{"signature":"Slice(category: string, value: number)","description":"Defines one labeled finite numeric value for future composition inside a proportional chart."}},"componentGroups":[{"name":"Interactive experiences","components":["Catalog","Dashboard","Form","Link"],"notes":["Use Catalog for visual discovery, Dashboard for filterable numeric datasets, Form for gathering preferences, and Link for opening a verified source. These are composable Card children."]},{"name":"Layout","components":["Card"]},{"name":"Charts","components":["BarChart","LineChart","AreaChart","RadarChart","HorizontalBarChart","SingleStackedBarChart","PieChart","RadialChart","ScatterChart"],"notes":["Charts must be direct children of the Card root."]},{"name":"Layout","components":["Separator"],"notes":["Use Separator only between adjacent Card children that need a visual break."]},{"name":"Layout","components":["StepsItem"],"notes":["Use StepsItem references inside Steps for ordered instructions; direct Card usage remains supported for backward compatibility."]},{"name":"Layout","components":["Steps"],"notes":["Use Steps to group between one and twelve StepsItem references in their intended order.","Steps owns the connecting trails, so the final item never displays a trail."]},{"name":"Components","components":["Tag"],"notes":["Use Tag for concise labels, categories, or statuses, not for sentences or actions."]},{"name":"Components","components":["TagBlock"],"notes":["Use TagBlock to group related Tag children; keep labels concise and preserve their reading order."]},{"name":"Content","components":["TextContent"],"notes":["Use TextContent for prose, labels, and emphasis; its size changes presentation without implying a heading level.","TextContent supports Markdown when the content needs inline or block formatting."]},{"name":"Content","components":["TextCallout"],"notes":["Use TextCallout for a concise contextual notice, status, warning, or error.","Provide at least a title or description; TextCallout is static content without actions."]},{"name":"Content","components":["Callout"],"notes":["Use Callout for a concise titled message with informational, success, warning, error, or neutral emphasis.","Always provide both a title and a supporting description; Callout is static content without actions."]},{"name":"Actions","components":["Button"],"notes":["Use Button only when the user can safely continue the conversation with a clear action.","Always provide label, value, and humanFriendlyMessage. Destructive type overrides hierarchy with the filled destructive appearance.","Button emits a continue_conversation event with value in params; it never opens a URL or invokes a tool directly."]},{"name":"Actions","components":["Buttons"],"notes":["Use Buttons to group between one and six Button references; preserve their priority and reading order.","Use row for compact actions that may wrap and column for vertically stacked choices.","Prefer at most one primary action in a real choice group. Multiple primary buttons remain valid for equal-priority actions and design specimens.","Buttons delegates every structured conversation action to its Button child; it never submits data, opens a URL, or invokes a tool directly."]},{"name":"Content","components":["Image"],"notes":["Use Image when a relevant public image URL is available; always provide concise, meaningful alternative text.","Omit src instead of inventing an image URL when no reliable source is available.","Only when the task explicitly retrieves source photos separately, set src to the exact supplied source page URL; its verified photo is attached independently. Otherwise use an approved image URL or omit src."]},{"name":"Media","components":["ImageBlock"],"notes":["Use ImageBlock when an Image needs a concise heading and supporting description.","Always provide meaningful alternative text on the referenced Image."]},{"name":"Media","components":["ImageGallery"],"notes":["Use ImageGallery to group between one and twelve related ImageBlock references in reading order.","Keep image headings and descriptions concise, and provide meaningful alternative text for every Image."]},{"name":"Lists","components":["ListBlock"],"notes":["Use ListBlock to group one or more related, scannable ListItem references.","Keep list titles concise and add subtitles only when they clarify an item."]},{"name":"Content","components":["ListItem"],"notes":["Use ListItem for concise, scannable points with an optional supporting subtitle.","ListItem is static content and never represents an action."]},{"name":"Content","components":["CardHeader"],"notes":["Use CardHeader at the beginning of a Card to introduce its content.","Provide a title, a subtitle, or both; omit fields that have no meaningful content."]},{"name":"Navigation","components":["Carousel"],"notes":["Use Carousel for two to twelve related slides when sequential browsing is more useful than showing every group at once.","Each slide contains between one and twenty content references; keep the first slide useful because Carousel never auto-advances."]},{"name":"Navigation","components":["Tabs"],"notes":["Use Tabs to group between one and twelve TabItem references with unique values.","Tabs initially selects the first item and supports horizontal arrow, Home, and End keyboard navigation."]},{"name":"Layout","components":["SectionBlock"],"notes":["Use SectionBlock to group between one and twenty related SectionItem references.","Keep every section title concise and use its description for supporting context."]},{"name":"Disclosure","components":["Accordion"],"notes":["Use Accordion to group between one and twelve AccordionItem references with unique values.","Accordion allows at most one item to be open at a time and initially opens the first item."]},{"name":"Data display","components":["Table"],"notes":["Use Table to display one to twelve Col references with unique labels.","Every Table column must contain the same non-zero number of values in row order."]}],"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"Catalog":{"$ref":"#/$defs/Catalog"},"Dashboard":{"$ref":"#/$defs/Dashboard"},"Form":{"$ref":"#/$defs/Form"},"Link":{"$ref":"#/$defs/Link"},"Card":{"$ref":"#/$defs/Card"},"BarChart":{"$ref":"#/$defs/BarChart"},"LineChart":{"$ref":"#/$defs/LineChart"},"AreaChart":{"$ref":"#/$defs/AreaChart"},"RadarChart":{"$ref":"#/$defs/RadarChart"},"HorizontalBarChart":{"$ref":"#/$defs/HorizontalBarChart"},"SingleStackedBarChart":{"$ref":"#/$defs/SingleStackedBarChart"},"PieChart":{"$ref":"#/$defs/PieChart"},"RadialChart":{"$ref":"#/$defs/RadialChart"},"ScatterChart":{"$ref":"#/$defs/ScatterChart"},"Separator":{"$ref":"#/$defs/Separator"},"StepsItem":{"$ref":"#/$defs/StepsItem"},"Steps":{"$ref":"#/$defs/Steps"},"Tag":{"$ref":"#/$defs/Tag"},"TagBlock":{"$ref":"#/$defs/TagBlock"},"TextContent":{"$ref":"#/$defs/TextContent"},"TextCallout":{"$ref":"#/$defs/TextCallout"},"Callout":{"$ref":"#/$defs/Callout"},"Button":{"$ref":"#/$defs/Button"},"Buttons":{"$ref":"#/$defs/Buttons"},"Image":{"$ref":"#/$defs/Image"},"ImageBlock":{"$ref":"#/$defs/ImageBlock"},"ImageGallery":{"$ref":"#/$defs/ImageGallery"},"ListBlock":{"$ref":"#/$defs/ListBlock"},"ListItem":{"$ref":"#/$defs/ListItem"},"CardHeader":{"$ref":"#/$defs/CardHeader"},"Carousel":{"$ref":"#/$defs/Carousel"},"Tabs":{"$ref":"#/$defs/Tabs"},"SectionBlock":{"$ref":"#/$defs/SectionBlock"},"Accordion":{"$ref":"#/$defs/Accordion"},"Table":{"$ref":"#/$defs/Table"},"Series":{"$ref":"#/$defs/Series"},"ScatterSeries":{"$ref":"#/$defs/ScatterSeries"},"Point":{"$ref":"#/$defs/Point"},"TabItem":{"$ref":"#/$defs/TabItem"},"SectionItem":{"$ref":"#/$defs/SectionItem"},"AccordionItem":{"$ref":"#/$defs/AccordionItem"},"Col":{"$ref":"#/$defs/Col"},"Slice":{"$ref":"#/$defs/Slice"}},"required":["Catalog","Dashboard","Form","Link","Card","BarChart","LineChart","AreaChart","RadarChart","HorizontalBarChart","SingleStackedBarChart","PieChart","RadialChart","ScatterChart","Separator","StepsItem","Steps","Tag","TagBlock","TextContent","TextCallout","Callout","Button","Buttons","Image","ImageBlock","ImageGallery","ListBlock","ListItem","CardHeader","Carousel","Tabs","SectionBlock","Accordion","Table","Series","ScatterSeries","Point","TabItem","SectionItem","AccordionItem","Col","Slice"],"additionalProperties":false,"$defs":{"Catalog":{"type":"object","properties":{"id":{"type":"string","maxLength":80,"pattern":"^[a-zA-Z0-9_-]+$"},"title":{"type":"string","minLength":1,"maxLength":160},"description":{"type":"string","maxLength":400},"items":{"minItems":1,"maxItems":40,"type":"array","items":{"type":"object","properties":{"id":{"type":"string","maxLength":80,"pattern":"^[a-zA-Z0-9_-]+$"},"title":{"type":"string","minLength":1,"maxLength":160},"description":{"type":"string","maxLength":600},"category":{"type":"string","minLength":1,"maxLength":160},"price":{"anyOf":[{"type":"number","minimum":0},{"type":"null"}]},"priceLabel":{"type":"string","maxLength":100},"attributes":{"maxItems":8,"type":"array","items":{"type":"string","maxLength":120}},"url":{"type":"string","maxLength":2048},"imageUrl":{"anyOf":[{"type":"string","maxLength":2048},{"type":"null"}]}},"required":["id","title","description","category","priceLabel","attributes","url"],"additionalProperties":false}}},"required":["id","title","description","items"],"additionalProperties":false,"id":"Catalog","description":"Searchable, sortable, selectable visual catalog with verified listing links, photos and comparison."},"Dashboard":{"type":"object","properties":{"id":{"type":"string","maxLength":80,"pattern":"^[a-zA-Z0-9_-]+$"},"title":{"type":"string","minLength":1,"maxLength":160},"description":{"type":"string","maxLength":400},"source":{"type":"string","minLength":1,"maxLength":300},"metrics":{"minItems":1,"maxItems":6,"type":"array","items":{"type":"object","properties":{"key":{"type":"string","maxLength":80,"pattern":"^[a-zA-Z0-9_-]+$"},"label":{"type":"string","minLength":1,"maxLength":160},"unit":{"type":"string","maxLength":30},"aggregation":{"type":"string","enum":["sum","average","ratio"]},"numerator":{"type":"string","maxLength":80,"pattern":"^[a-zA-Z0-9_-]+$"},"denominator":{"type":"string","maxLength":80,"pattern":"^[a-zA-Z0-9_-]+$"}},"required":["key","label","unit","aggregation"],"additionalProperties":false}},"rows":{"minItems":1,"maxItems":180,"type":"array","items":{"type":"object","properties":{"period":{"type":"string","minLength":1,"maxLength":160},"category":{"type":"string","minLength":1,"maxLength":160},"values":{"type":"object","propertyNames":{"type":"string","maxLength":80,"pattern":"^[a-zA-Z0-9_-]+$"},"additionalProperties":{"type":"number"}}},"required":["period","category","values"],"additionalProperties":false}}},"required":["id","title","description","source","metrics","rows"],"additionalProperties":false,"id":"Dashboard","description":"Interactive metrics and charts recalculated from supplied rows when period/category filters change."},"Form":{"type":"object","properties":{"id":{"type":"string","maxLength":80,"pattern":"^[a-zA-Z0-9_-]+$"},"title":{"type":"string","minLength":1,"maxLength":160},"description":{"type":"string","maxLength":400},"fields":{"minItems":1,"maxItems":8,"type":"array","items":{"type":"object","properties":{"id":{"type":"string","maxLength":80,"pattern":"^[a-zA-Z0-9_-]+$"},"label":{"type":"string","minLength":1,"maxLength":160},"type":{"type":"string","enum":["text","number","select"]},"required":{"type":"boolean"},"options":{"maxItems":20,"type":"array","items":{"type":"string","minLength":1,"maxLength":160}}},"required":["id","label","type","required","options"],"additionalProperties":false}},"submitLabel":{"type":"string","minLength":1,"maxLength":160},"message":{"type":"string","minLength":1,"maxLength":500}},"required":["id","title","description","fields","submitLabel","message"],"additionalProperties":false,"id":"Form","description":"A validated preference form that continues the conversation with the supplied answers."},"Link":{"type":"object","properties":{"label":{"type":"string","minLength":1,"maxLength":160},"url":{"type":"string","maxLength":2048}},"required":["label","url"],"additionalProperties":false,"id":"Link","description":"Open a verified public HTTPS source in a new tab."},"Card":{"type":"object","properties":{"children":{"minItems":1,"maxItems":20,"type":"array","items":{"anyOf":[{"$ref":"#/$defs/Catalog"},{"$ref":"#/$defs/Dashboard"},{"$ref":"#/$defs/Form"},{"$ref":"#/$defs/Link"},{"$ref":"#/$defs/BarChart"},{"$ref":"#/$defs/LineChart"},{"$ref":"#/$defs/AreaChart"},{"$ref":"#/$defs/RadarChart"},{"$ref":"#/$defs/HorizontalBarChart"},{"$ref":"#/$defs/SingleStackedBarChart"},{"$ref":"#/$defs/PieChart"},{"$ref":"#/$defs/RadialChart"},{"$ref":"#/$defs/ScatterChart"},{"$ref":"#/$defs/Button"},{"$ref":"#/$defs/Buttons"},{"$ref":"#/$defs/CardHeader"},{"$ref":"#/$defs/Image"},{"$ref":"#/$defs/ImageBlock"},{"$ref":"#/$defs/ListBlock"},{"$ref":"#/$defs/ListItem"},{"$ref":"#/$defs/Separator"},{"$ref":"#/$defs/Steps"},{"$ref":"#/$defs/StepsItem"},{"$ref":"#/$defs/Tag"},{"$ref":"#/$defs/TagBlock"},{"$ref":"#/$defs/TextContent"},{"$ref":"#/$defs/TextCallout"},{"$ref":"#/$defs/Accordion"},{"$ref":"#/$defs/Callout"},{"$ref":"#/$defs/Carousel"},{"$ref":"#/$defs/ImageGallery"},{"$ref":"#/$defs/SectionBlock"},{"$ref":"#/$defs/Table"},{"$ref":"#/$defs/Tabs"},{"$ref":"#/$defs/Card"}]}},"variant":{"type":"string","enum":["card","clear","sunk"]},"direction":{"type":"string","enum":["row","column"]},"gap":{"type":"string","enum":["xs","s","m","l"]},"align":{"type":"string","enum":["start","center","end","stretch"]},"justify":{"type":"string","enum":["start","center","end","space-between"]}},"required":["children"],"additionalProperties":false,"id":"Card","description":"Groups related content and nested Cards into responsive visual compositions. Omitted layout props preserve existing cards; use clear explicitly for transparent groups."},"BarChart":{"type":"object","properties":{"title":{"type":"string","minLength":1,"maxLength":120},"labels":{"minItems":1,"maxItems":50,"type":"array","items":{"type":"string"}},"series":{"minItems":1,"maxItems":6,"type":"array","items":{"$ref":"#/$defs/Series"}},"variant":{"type":"string","enum":["grouped","stacked"]},"xLabel":{"type":"string","minLength":1,"maxLength":60},"yLabel":{"type":"string","minLength":1,"maxLength":60}},"required":["title","labels","series"],"additionalProperties":false,"id":"BarChart","description":"Compares one or more series across categories with bars."},"Series":{"type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":60},"values":{"minItems":1,"maxItems":50,"type":"array","items":{"type":"number"}}},"required":["name","values"],"additionalProperties":false,"id":"Series","description":"A named numeric series used by cartesian and radar charts."},"LineChart":{"type":"object","properties":{"title":{"type":"string","minLength":1,"maxLength":120},"labels":{"minItems":1,"maxItems":50,"type":"array","items":{"type":"string"}},"series":{"minItems":1,"maxItems":6,"type":"array","items":{"$ref":"#/$defs/Series"}},"curve":{"type":"string","enum":["linear","monotone","step"]},"xLabel":{"type":"string","minLength":1,"maxLength":60},"yLabel":{"type":"string","minLength":1,"maxLength":60}},"required":["title","labels","series"],"additionalProperties":false,"id":"LineChart","description":"Shows changes or trends across ordered categories."},"AreaChart":{"type":"object","properties":{"title":{"type":"string","minLength":1,"maxLength":120},"labels":{"minItems":1,"maxItems":50,"type":"array","items":{"type":"string"}},"series":{"minItems":1,"maxItems":6,"type":"array","items":{"$ref":"#/$defs/Series"}},"curve":{"type":"string","enum":["linear","monotone","step"]},"xLabel":{"type":"string","minLength":1,"maxLength":60},"yLabel":{"type":"string","minLength":1,"maxLength":60}},"required":["title","labels","series"],"additionalProperties":false,"id":"AreaChart","description":"Shows trends with filled areas emphasizing magnitude."},"RadarChart":{"type":"object","properties":{"title":{"type":"string","minLength":1,"maxLength":120},"labels":{"minItems":1,"maxItems":50,"type":"array","items":{"type":"string"}},"series":{"minItems":1,"maxItems":6,"type":"array","items":{"$ref":"#/$defs/Series"}},"xLabel":{"type":"string","minLength":1,"maxLength":60},"yLabel":{"type":"string","minLength":1,"maxLength":60}},"required":["title","labels","series"],"additionalProperties":false,"id":"RadarChart","description":"Compares multivariate profiles around a radial axis."},"HorizontalBarChart":{"type":"object","properties":{"title":{"type":"string","minLength":1,"maxLength":120},"labels":{"minItems":1,"maxItems":50,"type":"array","items":{"type":"string"}},"series":{"minItems":1,"maxItems":6,"type":"array","items":{"$ref":"#/$defs/Series"}},"xLabel":{"type":"string","minLength":1,"maxLength":60},"yLabel":{"type":"string","minLength":1,"maxLength":60}},"required":["title","labels","series"],"additionalProperties":false,"id":"HorizontalBarChart","description":"Ranks categorical values with horizontal bars."},"SingleStackedBarChart":{"type":"object","properties":{"title":{"type":"string","minLength":1,"maxLength":120},"labels":{"minItems":1,"maxItems":12,"type":"array","items":{"type":"string"}},"values":{"minItems":1,"maxItems":12,"type":"array","items":{"type":"number"}}},"required":["title","labels","values"],"additionalProperties":false,"id":"SingleStackedBarChart","description":"Shows how labeled values contribute to one whole."},"PieChart":{"type":"object","properties":{"title":{"type":"string","minLength":1,"maxLength":120},"labels":{"minItems":1,"maxItems":12,"type":"array","items":{"type":"string"}},"values":{"minItems":1,"maxItems":12,"type":"array","items":{"type":"number"}},"variant":{"type":"string","enum":["pie","donut"]}},"required":["title","labels","values"],"additionalProperties":false,"id":"PieChart","description":"Shows proportional parts of a whole as a pie or donut."},"RadialChart":{"type":"object","properties":{"title":{"type":"string","minLength":1,"maxLength":120},"labels":{"minItems":1,"maxItems":12,"type":"array","items":{"type":"string"}},"values":{"minItems":1,"maxItems":12,"type":"array","items":{"type":"number"}}},"required":["title","labels","values"],"additionalProperties":false,"id":"RadialChart","description":"Shows percentage values as radial progress bars."},"ScatterChart":{"type":"object","properties":{"title":{"type":"string","minLength":1,"maxLength":120},"datasets":{"minItems":1,"maxItems":6,"type":"array","items":{"$ref":"#/$defs/ScatterSeries"}},"xLabel":{"type":"string","minLength":1,"maxLength":60},"yLabel":{"type":"string","minLength":1,"maxLength":60}},"required":["title","datasets"],"additionalProperties":false,"id":"ScatterChart","description":"Shows relationships between two numeric variables."},"ScatterSeries":{"type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":60},"points":{"minItems":1,"maxItems":100,"type":"array","items":{"$ref":"#/$defs/Point"}}},"required":["name","points"],"additionalProperties":false,"id":"ScatterSeries","description":"A named collection of points used by a scatter chart."},"Point":{"type":"object","properties":{"x":{"type":"number"},"y":{"type":"number"}},"required":["x","y"],"additionalProperties":false,"id":"Point","description":"One numeric x/y point used by a scatter series."},"Button":{"type":"object","properties":{"label":{"type":"string","minLength":1,"maxLength":120},"value":{"type":"string","minLength":1,"maxLength":200},"humanFriendlyMessage":{"type":"string","minLength":1,"maxLength":500},"hierarchy":{"default":"primary","type":"string","enum":["primary","secondary","tertiary"]},"type":{"default":"normal","type":"string","enum":["normal","destructive"]},"size":{"default":32,"anyOf":[{"type":"number","const":24},{"type":"number","const":28},{"type":"number","const":32},{"type":"number","const":36}]}},"required":["label","value","humanFriendlyMessage","hierarchy","type","size"],"additionalProperties":false,"id":"Button","description":"Triggers a safe, structured conversation action from a labeled button."},"Buttons":{"type":"object","properties":{"buttons":{"minItems":1,"maxItems":6,"type":"array","items":{"$ref":"#/$defs/Button"}},"direction":{"default":"row","type":"string","enum":["row","column"]}},"required":["buttons","direction"],"additionalProperties":false,"id":"Buttons","description":"Groups one to six conversation actions in a responsive row or column."},"CardHeader":{"type":"object","properties":{"title":{"type":"string","maxLength":240},"subtitle":{"type":"string","maxLength":1000}},"additionalProperties":false,"id":"CardHeader","description":"Introduces Card content with an optional title, optional supporting subtitle, or both."},"Image":{"type":"object","properties":{"alt":{"type":"string","minLength":1,"maxLength":500},"src":{"type":"string","minLength":1}},"required":["alt"],"additionalProperties":false,"id":"Image","description":"Displays an accessible image from an optional trusted source URL."},"ImageBlock":{"type":"object","properties":{"image":{"$ref":"#/$defs/Image"},"heading":{"type":"string","minLength":1,"maxLength":200},"description":{"type":"string","minLength":1,"maxLength":500}},"required":["image","heading","description"],"additionalProperties":false,"id":"ImageBlock","description":"Displays an accessible image with a concise heading and supporting description."},"ListBlock":{"type":"object","properties":{"children":{"minItems":1,"maxItems":20,"type":"array","items":{"$ref":"#/$defs/ListItem"}}},"required":["children"],"additionalProperties":false,"id":"ListBlock","description":"Groups related list items 